# Copy to .env and fill in. Never commit .env.

# Deploy / broadcast
PRIVATE_KEY=

# RPC endpoints (see foundry.toml [rpc_endpoints])
RPC_URL=
ROBINHOOD_RPC_URL=
SEPOLIA_RPC_URL=

# Verification (optional)
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# DeployAgentCore.s.sol — FeeManager, VaultTrackRegistry, AgentRegistry
# ---------------------------------------------------------------------------
ADMIN=
TREASURY=
USDC=              # immutable fee asset for FeeManager (e.g. USDC)
REGISTRATION_FEE_AMOUNT=
ERC8004_IDENTITY_REGISTRY=   # required; immutable at AgentRegistry deploy
ERC8004_CHAIN_ID=            # required; must equal the chain you broadcast on (e.g. 84532 for Base Sepolia)
BACKEND_RELAYER=             # API relayer; granted REGISTRAR_ROLE on AgentRegistry at deploy

# ---------------------------------------------------------------------------
# DeployVaultInfrastructure.s.sol — full vault + allocation greenfield deploy
# ---------------------------------------------------------------------------
# Uses ADMIN, TREASURY, USDC above.
# Deploys MandateVaultFactory + four EIP-1167 vault clones (FOUNDATION, TECH, VOLATILITY, MACRO).

# ---------------------------------------------------------------------------
# SetRegistrationFee.s.sol — set registration fee to 0.1 USDC on deployed FeeManager
# ---------------------------------------------------------------------------
FEE_MANAGER=

# ---------------------------------------------------------------------------
# ConfigureVaultTracks.s.sol — register vaults + track 0/1/2 policy on VaultTrackRegistry
# ---------------------------------------------------------------------------
VAULT_TRACK_REGISTRY=
FOUNDATION_VAULT=
TECH_VAULT=
VOLATILITY_VAULT=
MACRO_VAULT=

# ---------------------------------------------------------------------------
# DeployTrading.s.sol — PositionManager, TradeRouter, swap adapter
# ---------------------------------------------------------------------------
EXECUTOR=           # EOA granted EXECUTOR_ROLE on TradeRouter
OPERATOR=           # optional; defaults to ADMIN — OPERATOR_ROLE for forceClose
AGENT_REGISTRY=
ALLOCATION_MANAGER=
VAULT_TRACK_REGISTRY=
VAULT=              # MandateVault clone; grants TRADE_ROUTER_ROLE to TradeRouter on this vault (repeat per vault)
DEPLOY_MOCK_SWAP_ADAPTER=true   # true = MockSwapAdapter; false = InventorySwapAdapter

# Existing swap adapter (if wiring manually instead of deploying in DeployTrading)
# SWAP_ADAPTER=

# ---------------------------------------------------------------------------
# DepositToTechVault.s.sol — deposit 10 USDC into TECH_VAULT
# ---------------------------------------------------------------------------
# PRIVATE_KEY, USDC, TECH_VAULT (see ConfigureVaultTracks / DeployVaultInfrastructure)

# ---------------------------------------------------------------------------
# Token catalog — MockPriceOracle + mock stocks (see config/token-catalog.json)
# ---------------------------------------------------------------------------
TOKEN_REGISTRY=
PRICE_ORACLE=          # MockPriceOracle from DeployPriceOracle.s.sol
ORACLE_KEEPER=         # granted ORACLE_UPDATER_ROLE on MockPriceOracle (API cron signer)
# FOUNDATION_VAULT, TECH_VAULT, VOLATILITY_VAULT, MACRO_VAULT — for DeployTokenCatalog.s.sol
