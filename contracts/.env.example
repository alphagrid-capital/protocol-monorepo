# Copy to .env and fill in. Never commit .env.

# Deploy / broadcast
PRIVATE_KEY=

# RPC endpoints (see foundry.toml [rpc_endpoints])
RPC_URL=
ROBINHOOD_RPC_URL=
SEPOLIA_RPC_URL=

# Verification (optional)
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# DeployAgentCore.s.sol — FeeManager, VaultTrackRegistry, AgentRegistry
# ---------------------------------------------------------------------------
ADMIN=
TREASURY=
USDC=              # immutable fee asset for FeeManager (e.g. USDC)
REGISTRATION_FEE_AMOUNT=
ERC8004_IDENTITY_REGISTRY=   # required; immutable at AgentRegistry deploy
ERC8004_CHAIN_ID=            # required; must equal the chain you broadcast on (e.g. 84532 for Base Sepolia)

# ---------------------------------------------------------------------------
# DeployVaultInfrastructure.s.sol — full vault + allocation greenfield deploy
# ---------------------------------------------------------------------------
# Uses ADMIN, TREASURY, USDC above.
# Deploys MandateVaultFactory + four EIP-1167 vault clones (FOUNDATION, TECH, VOLATILITY, MACRO).

# ---------------------------------------------------------------------------
# DeployTrading.s.sol — PositionManager, TradeRouter, swap adapter
# ---------------------------------------------------------------------------
EXECUTOR=           # EOA granted EXECUTOR_ROLE on TradeRouter
OPERATOR=           # optional; defaults to ADMIN — OPERATOR_ROLE for forceClose
AGENT_REGISTRY=
ALLOCATION_MANAGER=
TRACK_CONFIG=
VAULT=              # vault to grant TRADE_ROUTER_ROLE (repeat per vault as needed)
DEPLOY_MOCK_SWAP_ADAPTER=true   # true = MockSwapAdapter; false = InventorySwapAdapter

# Existing swap adapter (if wiring manually instead of deploying in DeployTrading)
# SWAP_ADAPTER=
