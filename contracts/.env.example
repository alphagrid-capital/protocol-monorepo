# Copy to .env and fill in. Never commit .env.

# Deploy / broadcast
PRIVATE_KEY=

# RPC endpoints (see foundry.toml [rpc_endpoints])
RPC_URL=
ROBINHOOD_RPC_URL=
SEPOLIA_RPC_URL=

# Verification (optional)
ETHERSCAN_API_KEY=

# Phase 1 deployment (DeployPhase1.s.sol)
ADMIN=
TREASURY=
USDC=              # immutable fee asset for FeeManager (e.g. USDC)
REGISTRATION_FEE_AMOUNT=

# Optional: existing FeeManager for DeployAgentRegistry.s.sol
FEE_MANAGER=
