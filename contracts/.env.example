# Copy to .env and fill in. Never commit .env.

# Deploy / broadcast
PRIVATE_KEY=

# RPC endpoints (see foundry.toml [rpc_endpoints])
RPC_URL=
ROBINHOOD_RPC_URL=
SEPOLIA_RPC_URL=

# Verification (optional)
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# Phase 1 (DeployPhase1.s.sol)
# ---------------------------------------------------------------------------
ADMIN=
TREASURY=
USDC=              # immutable fee asset for FeeManager (e.g. USDC)
REGISTRATION_FEE_AMOUNT=

# Optional: existing FeeManager for DeployAgentRegistry.s.sol
FEE_MANAGER=

# ---------------------------------------------------------------------------
# Phase 2 (DeployPhase2.s.sol)
# ---------------------------------------------------------------------------
# Uses ADMIN, TREASURY, USDC above.
# Wires FeeManager, TrackConfig, TokenRegistry, AgentRegistry, AllocationManager,
# and four AlphaGridVault instances (FOUNDATION, TECH, VOLATILITY, MACRO).

# ---------------------------------------------------------------------------
# Phase 3 (DeployPhase3.s.sol)
# ---------------------------------------------------------------------------
EXECUTOR=           # EOA granted EXECUTOR_ROLE on TradeRouter
OPERATOR=           # optional; defaults to ADMIN — OPERATOR_ROLE for forceClose
AGENT_REGISTRY=
ALLOCATION_MANAGER=
TRACK_CONFIG=
VAULT=              # vault to grant TRADE_ROUTER_ROLE (repeat per vault as needed)
DEPLOY_MOCK_SWAP_ADAPTER=true   # true = MockSwapAdapter; false = InventorySwapAdapter

# Existing swap adapter (if wiring manually instead of deploying in Phase 3)
# SWAP_ADAPTER=
