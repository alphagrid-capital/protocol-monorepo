# Copy to .env and fill in. Never commit .env.

# Deploy / broadcast
PRIVATE_KEY=

# RPC endpoints (see foundry.toml [rpc_endpoints])
RPC_URL=
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
ARBITRUM_RPC_URL=
ROBINHOOD_TESTNET_RPC_URL=
ROBINHOOD_RPC_URL=

# Verification (optional)
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# Shared — ADMIN, TREASURY, BACKEND_RELAYER, ERC8004_*
# ---------------------------------------------------------------------------
ADMIN=
TREASURY=
FEE_ASSET=         # FeeManager / x402 (official USDC on testnet)
VAULT_ASSET=       # vault + trading underlying (Mocked Stable); optional for DeployFullStack (deploys mSTBL)
USDC=              # legacy: sets both FEE_ASSET and VAULT_ASSET when the vars above are omitted
REGISTRATION_FEE_AMOUNT=   # optional; defaults to 0.1 USDC (Fees.REGISTRATION_FEE)
ERC8004_IDENTITY_REGISTRY=   # immutable at AgentRegistry deploy
ERC8004_CHAIN_ID=            # optional; defaults to broadcast chain ID
BACKEND_RELAYER=             # API relayer; granted REGISTRAR_ROLE on AgentRegistry at deploy

# ---------------------------------------------------------------------------
# DeployVaultInfrastructure.s.sol — full vault + allocation greenfield deploy
# ---------------------------------------------------------------------------
# Uses ADMIN, TREASURY, FEE_ASSET, VAULT_ASSET (or USDC for both).
# Deploys MandateVaultFactory + four EIP-1167 vault clones (FOUNDATION, TECH, VOLATILITY, MACRO).

# ---------------------------------------------------------------------------
# ops/SetRegistrationFee.s.sol — set registration fee on deployed FeeManager
# ---------------------------------------------------------------------------
FEE_MANAGER=

# ---------------------------------------------------------------------------
# DeployTrading.s.sol / DeployTokenCatalog.s.sol — existing vault addresses
# ---------------------------------------------------------------------------
VAULT_TRACK_REGISTRY=
FOUNDATION_VAULT=
TECH_VAULT=
VOLATILITY_VAULT=
MACRO_VAULT=

# ---------------------------------------------------------------------------
# DeployTrading.s.sol — PositionManager, TradeRouter, swap adapter
# ---------------------------------------------------------------------------
EXECUTOR=           # EOA granted EXECUTOR_ROLE on TradeRouter
OPERATOR=           # optional; defaults to ADMIN — OPERATOR_ROLE for forceClose
AGENT_REGISTRY=
ALLOCATION_MANAGER=
VAULT_TRACK_REGISTRY=
DEPLOY_MOCK_SWAP_ADAPTER=true   # true = MockSwapAdapter; false = InventorySwapAdapter

# ---------------------------------------------------------------------------
# ops/DepositToTechVault.s.sol — deposit USDC into TECH_VAULT
# ---------------------------------------------------------------------------
DEPOSITOR=
DEPOSIT_AMOUNT=     # optional; defaults to 10 USDC (Fees.DEFAULT_TECH_DEPOSIT)
# PRIVATE_KEY, VAULT_ASSET (or USDC), TECH_VAULT

# ---------------------------------------------------------------------------
# DeployFullStack.s.sol — dev-complete greenfield (core + tracks + trading + oracle + catalog)
# ---------------------------------------------------------------------------
# FEE_ASSET / VAULT_ASSET optional (deploys mSTBL vault asset when VAULT_ASSET unset).
# Uses EXECUTOR, OPERATOR, ORACLE_KEEPER above.

# ---------------------------------------------------------------------------
# Token catalog — MockPriceOracle + mock stocks (see config/token-catalog.json)
# ---------------------------------------------------------------------------
TOKEN_REGISTRY=
PRICE_ORACLE=          # MockPriceOracle from DeployPriceOracle.s.sol
ORACLE_KEEPER=         # granted ORACLE_UPDATER_ROLE on MockPriceOracle (API cron signer)
# FOUNDATION_VAULT, TECH_VAULT, VOLATILITY_VAULT, MACRO_VAULT — for DeployTokenCatalog.s.sol
