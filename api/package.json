{
  "name": "@alphagrid/api",
  "version": "0.0.2",
  "private": true,
  "description": "AlphaGrid HTTP API and MCP server (Cloudflare Workers).",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync-abis": "node ../scripts/sync-contract-abis.mjs",
    "format:abis": "prettier --write src/services/abis",
    "dev": "wrangler dev --install-skills=false",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "lint:ts": "eslint \"src/**/*.ts\" --fix",
    "lint:fix": "eslint \"src/**/*.ts\" --fix"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250531.0",
    "@hono/eslint-config": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.8.3",
    "wrangler": "^4.19.1"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "@modelcontextprotocol/hono": "^2.0.0-alpha.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "@x402/core": "^2.14.0",
    "@x402/evm": "^2.14.0",
    "@x402/hono": "^2.14.0",
    "agents": "^0.15.0",
    "hono": "^4.12.23",
    "viem": "^2.31.0",
    "zod": "^4.4.3"
  }
}
