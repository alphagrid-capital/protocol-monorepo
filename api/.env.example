# Local development / deploy (wrangler dev, wrangler deploy).
# GitHub Actions uses the same names as repository secrets (see api/README.md).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# ENABLE_SWAGGER=true

# Agent registration (x402 + AgentRegistry). Omit for mock mode.
# RPC_URL=https://...
# CHAIN_ID=84532
# X402_NETWORK=eip155:84532
# X402_FACILITATOR_URL=https://x402.org/facilitator
# RELAYER_PRIVATE_KEY=0x...
