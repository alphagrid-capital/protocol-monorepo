# Local development / deploy (wrangler dev, wrangler deploy --env <name>).
# GitHub Actions uses GitHub Environments (see api/README.md).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# ENABLE_SWAGGER=true

# Chain is set per Wrangler env in wrangler.toml (CHAIN_ID, X402_NETWORK).
# For plain `wrangler dev`, set these in api/.dev.vars (gitignored):
# CHAIN_ID=421614
# X402_NETWORK=eip155:421614

# Per-chain secrets (wrangler secret put <NAME> --env <env> or api/.dev.vars):
# RPC_URL=https://...
# X402_FACILITATOR_URL=https://x402.org/facilitator
# RELAYER_PRIVATE_KEY=0x...
# EXECUTOR_PRIVATE_KEY=0x...
# ORACLE_KEEPER_PRIVATE_KEY=0x...
# FINNHUB_API_KEY=
# ORACLE_REFRESH_SECRET=   # optional; protects POST /prices/refresh

# Privy auth (optional until /auth routes are used)
# PRIVY_APP_ID=            # set in [env.*.vars] or api/.dev.vars
# PRIVY_JWT_VERIFICATION_KEY=  # wrangler secret put PRIVY_JWT_VERIFICATION_KEY --env <name>
