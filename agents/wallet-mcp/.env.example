# Copy to .env for local development (`yarn dev`).
# For MCP clients (Cursor, Claude Desktop), set the same vars in mcp.json instead.

# -----------------------------------------------------------------------------
# viem (local private key)
# -----------------------------------------------------------------------------
# WALLET_PROVIDER=viem

# Required — chain for the local wallet (no default).
# NETWORK_ID=base-sepolia
# NETWORK_ID values: ethereum-mainnet, ethereum-sepolia, polygon-mainnet,
# polygon-mumbai, base-mainnet, base-sepolia, arbitrum-mainnet, arbitrum-sepolia,
# optimism-mainnet, optimism-sepolia

# Optional — hex private key; a new ephemeral key is generated if omitted.
# PRIVATE_KEY=0x...

# Optional — both required to enable faucet and x402 tools while on viem.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# -----------------------------------------------------------------------------
# Coinbase Developer Platform (CDP smart wallet)
# -----------------------------------------------------------------------------
# WALLET_PROVIDER=cdp

# Required
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# CDP_WALLET_SECRET=

# Optional — defaults to base-sepolia
# NETWORK_ID=base-sepolia

# Optional — reuse an existing smart wallet or owner
# ADDRESS=0x...
# OWNER_ADDRESS=0x...

# Optional — custom RPC, paymaster, or idempotency for wallet operations
# RPC_URL=https://...
# PAYMASTER_URL=https://...
# IDEMPOTENCY_KEY=
