{
  "mcpServers": {
    "alphagrid-local-wallet-mcp": {
      "command": "node",
      "args": ["agents/wallet-mcp/build/index.js"],
      "env": {
        "WALLET_PROVIDER": "viem",
        "NETWORK_ID": "base-sepolia",
        "PRIVATE_KEY": "0x..."
      }
    },
    "alphagrid-mcp-server": {
      "url": "https://alphagrid-api.artiffine-delivery.workers.dev/mcp"
    }
  }
}
